#!/usr/bin/env bash

set -euo pipefail

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_DIR=$(cd "$TEST_DIR/.." && pwd)
TEST_RUNTIME=$(mktemp -d /tmp/omarchy-restic-runtime.XXXXXX)
IMPORT_ROOT="$TEST_RUNTIME/imports"
trap 'rm -rf -- "$TEST_RUNTIME"' EXIT
chmod 700 "$TEST_RUNTIME"
mkdir -p "$IMPORT_ROOT/qs"
ln -s /usr/share/omarchy/shell/Ui "$IMPORT_ROOT/qs/Ui"
ln -s /usr/share/omarchy/shell/Commons "$IMPORT_ROOT/qs/Commons"

run_test() {
  local file=$1
  local expected=$2
  local plugin_dir=${3:-$PROJECT_DIR}
  local output

  if ! output=$(
    WAYLAND_DISPLAY= \
    XDG_RUNTIME_DIR="$TEST_RUNTIME" \
    QT_QPA_PLATFORM=offscreen \
    QML_IMPORT_PATH="$IMPORT_ROOT" \
    QML2_IMPORT_PATH="$IMPORT_ROOT" \
    RESTIC_PLUGIN_DIR="$plugin_dir" \
      quickshell --no-color -p "$file" 2>&1
  ); then
    printf '%s\n' "$output" >&2
    exit 1
  fi
  if ! grep -q "$expected" <<<"$output"; then
    printf '%s\n' "$output" >&2
    exit 1
  fi
}

MODEL_TEST_DIR="$TEST_RUNTIME/model"
mkdir -p "$MODEL_TEST_DIR"
cp "$TEST_DIR/test-model.qml" "$MODEL_TEST_DIR/test-model.qml"
ln -s "$PROJECT_DIR/Model.js" "$MODEL_TEST_DIR/Model.js"

run_test "$MODEL_TEST_DIR/test-model.qml" "model tests passed"
run_test "$TEST_DIR/test-service.qml" "service tests passed"

STARTUP_PLUGIN_DIR="$TEST_RUNTIME/plugin # 100% ü"
mkdir -p "$STARTUP_PLUGIN_DIR/scripts"
cp "$PROJECT_DIR/Service.qml" "$PROJECT_DIR/Model.js" "$STARTUP_PLUGIN_DIR/"
cat > "$STARTUP_PLUGIN_DIR/scripts/restic_status.py" <<'PY'
import datetime
import json
import sys

options = dict(zip(sys.argv[1::2], sys.argv[2::2]))
print(json.dumps({
    "schemaVersion": 1,
    "generatedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "overallStatus": "healthy",
    "summary": {"jobs": 1, "healthy": 1},
    "config": {"status": "ready", "options": options},
    "jobs": [{"id": "fixture", "status": "healthy"}],
}))
PY
run_test "$TEST_DIR/test-startup.qml" "startup tests passed" "$STARTUP_PLUGIN_DIR"

printf 'Headless QML model, service, and startup tests passed\n'
