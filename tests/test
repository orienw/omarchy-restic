#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s "$PROJECT_DIR/tests" -v
"$PROJECT_DIR/tests/lint-qml"
"$PROJECT_DIR/tests/test-qml"
if [[ -n ${XDG_RUNTIME_DIR:-} && -n ${WAYLAND_DISPLAY:-} \
    && -S ${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY} ]]; then
  "$PROJECT_DIR/tests/test-ui"
else
  printf 'UI smoke tests skipped: no active Wayland session\n'
fi
omarchy plugin validate "$PROJECT_DIR"

printf 'All tests passed\n'
